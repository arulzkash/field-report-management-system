{
  "name": "field-report-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "tsx src/scripts/check-database.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests *.ts *.js *.json --ignore-unknown",
    "format:check": "prettier --check src tests *.ts *.js *.json --ignore-unknown",
    "test": "vitest run",
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "db:migrate": "prisma migrate deploy",
    "db:export": "tsx src/scripts/export-schema.ts",
    "db:seed": "prisma db seed"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
